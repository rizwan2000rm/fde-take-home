# Grafana Cloud > Observability > Frontend > your application > Settings > Web SDK Config.
# Name the Cloud application observable-outfitters for the supplied dashboard queries.
# Public browser ingestion endpoint, NOT a Grafana API token.
NEXT_PUBLIC_FARO_URL=
NEXT_PUBLIC_APP_ENVIRONMENT=development
NEXT_PUBLIC_APP_VERSION=0.1.0

# Server-only OTLP/HTTP protobuf export. Leave the endpoint empty to disable it.
# Grafana Cloud portal > your stack > OpenTelemetry > Configure.
# Use a stack-scoped token with traces:write and logs:write. Never prefix these with NEXT_PUBLIC_.
OTEL_SERVICE_NAME=observable-outfitters-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Example value: Authorization=Basic <base64(instance-id:token)>
OTEL_EXPORTER_OTLP_HEADERS=
