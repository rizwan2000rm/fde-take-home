{
  "id": null,
  "uid": "observable-outfitters-business",
  "title": "Observable Outfitters \u00b7 Business Impact",
  "description": "Browser activity, server-confirmed orders, cart dropoff, and checkout outcomes.",
  "tags": [
    "observable-outfitters",
    "business",
    "faro"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "refresh": "15s",
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "logs",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "grafanacloud-jumbolentil581-logs",
          "value": "grafanacloud-logs"
        },
        "refresh": 1
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "development,test,production",
        "current": {
          "text": "development",
          "value": "development"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "options": [
          {
            "text": "development",
            "value": "development",
            "selected": true
          },
          {
            "text": "test",
            "value": "test",
            "selected": false
          },
          {
            "text": "production",
            "value": "production",
            "selected": false
          }
        ]
      },
      {
        "name": "idle_timeout_seconds",
        "label": "Dropoff timeout",
        "description": "Required inactivity since the session\u2019s last recorded event.",
        "type": "custom",
        "query": "Demo (60s) : 60,Normal (15m) : 900",
        "current": {
          "text": "Demo (60s)",
          "value": "60"
        },
        "includeAll": false,
        "multi": false,
        "options": [
          {
            "text": "Demo (60s)",
            "value": "60",
            "selected": true
          },
          {
            "text": "Normal (15m)",
            "value": "900",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Active Sessions per Minute",
      "description": "Distinct sessions with recorded events each minute.",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "$logs"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 85,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "barAlignment": -1,
            "barWidthFactor": 0.8,
            "axisLabel": "Sessions / min"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "# Count distinct active sessions in each minute; show 0 when empty.\ncount(\n  sum by (session_id) (\n    count_over_time(\n      {service_name=\"observable-outfitters\", kind=\"event\", deployment_environment=~\"$environment\"}\n        | logfmt\n        | __error__=\"\"\n        | session_id!=\"\"\n        [1m]\n    )\n  )\n)\nor vector(0)",
          "queryType": "range",
          "editorMode": "code",
          "datasource": {
            "type": "loki",
            "uid": "$logs"
          },
          "legendFormat": "Sessions",
          "interval": "1m",
          "step": "1m"
        }
      ],
      "interval": "1m",
      "maxDataPoints": 300
    },
    {
      "id": 2,
      "title": "Cart Dropoff Rate",
      "description": "Inactive sessions with a confirmed cart addition and no accepted order, as a percentage of eligible sessions.",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "$logs"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 3,
            "fillOpacity": 14,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "off"
            },
            "pointSize": 5,
            "axisLabel": "Dropoffs (%)"
          },
          "max": 100,
          "displayName": "Cart dropoff rate"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "EligibleSessions",
          "expr": "# Sessions reaching inactivity after a confirmed cart addition.\ncount(\n  sum by (session_id) (\n    count_over_time(\n      {service_name=~\"observable-outfitters(-api)?\"}\n        | logfmt\n        | __error__=\"\"\n        | kind=\"event\"\n        | label_format environment=`{{or .deployment_environment_name .deployment_environment}}`\n        | environment=~\"$environment\"\n        | session_id!=\"\"\n      [1m] offset ${idle_timeout_seconds}s\n    )\n  )\n  unless\n  sum by (session_id) (\n    count_over_time(\n      {service_name=~\"observable-outfitters(-api)?\"}\n        | logfmt\n        | __error__=\"\"\n        | kind=\"event\"\n        | label_format environment=`{{or .deployment_environment_name .deployment_environment}}`\n        | environment=~\"$environment\"\n        | session_id!=\"\"\n      [${idle_timeout_seconds}s]\n    )\n  )\n  and\n  sum by (session_id) (\n    count_over_time(\n      {service_name=\"observable-outfitters-api\"}\n      | deployment_environment_name=~\"$environment\"\n      | event_name=\"shop.cart_add\"\n      | event_data_outcome=\"success\"\n      | session_id!=\"\"\n      [4h1m] offset ${idle_timeout_seconds}s\n    )\n  )\n)\nor vector(0)",
          "queryType": "range",
          "editorMode": "code",
          "datasource": {
            "type": "loki",
            "uid": "$logs"
          },
          "legendFormat": "Eligible sessions",
          "interval": "1m",
          "step": "1m",
          "hide": true
        },
        {
          "refId": "DroppedSessions",
          "expr": "# Eligible sessions without a server-confirmed checkout.\ncount(\n  sum by (session_id) (\n    count_over_time(\n      {service_name=~\"observable-outfitters(-api)?\"}\n        | logfmt\n        | __error__=\"\"\n        | kind=\"event\"\n        | label_format environment=`{{or .deployment_environment_name .deployment_environment}}`\n        | environment=~\"$environment\"\n        | session_id!=\"\"\n      [1m] offset ${idle_timeout_seconds}s\n    )\n  )\n  unless\n  sum by (session_id) (\n    count_over_time(\n      {service_name=~\"observable-outfitters(-api)?\"}\n        | logfmt\n        | __error__=\"\"\n        | kind=\"event\"\n        | label_format environment=`{{or .deployment_environment_name .deployment_environment}}`\n        | environment=~\"$environment\"\n        | session_id!=\"\"\n      [${idle_timeout_seconds}s]\n    )\n  )\n  and\n  sum by (session_id) (\n    count_over_time(\n      {service_name=\"observable-outfitters-api\"}\n      | deployment_environment_name=~\"$environment\"\n      | event_name=\"shop.cart_add\"\n      | event_data_outcome=\"success\"\n      | session_id!=\"\"\n      [4h1m] offset ${idle_timeout_seconds}s\n    )\n  )\n  unless\n  sum by (session_id) (\n    count_over_time(\n      {service_name=\"observable-outfitters-api\"}\n      | deployment_environment_name=~\"$environment\"\n      | event_name=\"shop.checkout\"\n      | event_data_outcome=\"success\"\n      | session_id!=\"\"\n      [4h1m] offset ${idle_timeout_seconds}s\n    )\n  )\n)\nor vector(0)",
          "queryType": "range",
          "editorMode": "code",
          "datasource": {
            "type": "loki",
            "uid": "$logs"
          },
          "legendFormat": "Dropped sessions",
          "interval": "1m",
          "step": "1m",
          "hide": true
        },
        {
          "refId": "DropoffPercentage",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "100 * $DroppedSessions / $EligibleSessions",
          "hide": false
        }
      ],
      "interval": "1m",
      "maxDataPoints": 300
    },
    {
      "id": 3,
      "title": "Views by Product",
      "description": "Product page views over the selected range, including repeat views.",
      "type": "barchart",
      "datasource": {
        "type": "loki",
        "uid": "$logs"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "orientation": "horizontal",
        "xField": "event_data_product_id",
        "showValue": "always",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "stacking": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "# Count product views over the selected dashboard range, including repeat views.\nsum by (event_data_product_id) (\n  count_over_time(\n    {service_name=\"observable-outfitters\", kind=\"event\", deployment_environment=~\"$environment\"}\n      | logfmt\n      | event_name=\"shop.product_view\"\n      [$__range]\n  )\n)",
          "queryType": "instant",
          "editorMode": "code",
          "datasource": {
            "type": "loki",
            "uid": "$logs"
          },
          "legendFormat": "{{event_data_product_id}}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Views"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Views",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Checkout Attempts",
      "description": "Successful and failed checkout requests per minute.",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "$logs"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 85,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barWidthFactor": 0.8,
            "barAlignment": -1,
            "axisLabel": "Attempts / min"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "displayName",
                "value": "Successful"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fail"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "displayName",
                "value": "Failed"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "# Count each completed API checkout once.\nsum by (event_data_outcome) (\n  count_over_time(\n    {service_name=\"observable-outfitters-api\"}\n      | deployment_environment_name=~\"$environment\"\n      | event_name=\"shop.checkout\"\n      [1m]\n  )\n)",
          "queryType": "range",
          "editorMode": "code",
          "datasource": {
            "type": "loki",
            "uid": "$logs"
          },
          "legendFormat": "{{event_data_outcome}}",
          "interval": "1m",
          "step": "1m"
        }
      ],
      "interval": "1m",
      "maxDataPoints": 300
    },
    {
      "id": 5,
      "title": "Units Purchased by Product",
      "description": "Units per product in orders saved by the backend over the selected range.",
      "type": "barchart",
      "datasource": {
        "type": "loki",
        "uid": "$logs"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "orientation": "horizontal",
        "xField": "event_data_product_id",
        "showValue": "always",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "stacking": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "# Sum server-recorded order quantities; browser confirmation is not required.\nsum by (event_data_product_id) (\n  sum_over_time(\n    {service_name=\"observable-outfitters-api\"}\n      | deployment_environment_name=~\"$environment\"\n      | event_name=\"shop.product_purchased\"\n      | unwrap event_data_quantity\n      | __error__=\"\"\n      [$__range]\n  )\n)",
          "queryType": "instant",
          "editorMode": "code",
          "datasource": {
            "type": "loki",
            "uid": "$logs"
          },
          "legendFormat": "{{event_data_product_id}}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Units"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Units",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Checkout Failure Rate",
      "description": "Failed checkout requests as a percentage of completed requests.",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "$logs"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 3,
            "fillOpacity": 14,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "off"
            },
            "pointSize": 5,
            "axisLabel": "Failed attempts (%)",
            "axisPlacement": "left"
          },
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CheckoutFailurePercentage"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "displayName",
                "value": "Failure rate"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Completed attempts"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": true,
                  "legend": true,
                  "tooltip": false
                }
              },
              {
                "id": "custom.axisPlacement",
                "value": "hidden"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "CompletedAttempts",
          "expr": "# Completed attempts per minute; zero when absent.\nsum(\n  count_over_time(\n    {service_name=\"observable-outfitters-api\"}\n      | deployment_environment_name=~\"$environment\"\n      | event_name=\"shop.checkout\"\n      [1m]\n  )\n)\nor vector(0)",
          "queryType": "range",
          "editorMode": "code",
          "datasource": {
            "type": "loki",
            "uid": "$logs"
          },
          "legendFormat": "Completed attempts",
          "interval": "1m",
          "step": "1m",
          "hide": false
        },
        {
          "refId": "FailedAttempts",
          "expr": "# Failed checkout requests per minute; zero when absent.\nsum(\n  count_over_time(\n    {service_name=\"observable-outfitters-api\"}\n      | deployment_environment_name=~\"$environment\"\n      | event_name=\"shop.checkout\"\n      | event_data_outcome=\"fail\"\n      [1m]\n  )\n)\nor vector(0)",
          "queryType": "range",
          "editorMode": "code",
          "datasource": {
            "type": "loki",
            "uid": "$logs"
          },
          "legendFormat": "Failed attempts",
          "interval": "1m",
          "step": "1m",
          "hide": true
        },
        {
          "refId": "CheckoutFailurePercentage",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "math",
          "expression": "100 * $FailedAttempts / $CompletedAttempts",
          "hide": false
        }
      ],
      "interval": "1m",
      "maxDataPoints": 300
    }
  ],
  "graphTooltip": 1
}
